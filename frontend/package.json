{
  "name": "celcoin-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "web": "vite",
    "web:build": "vite build",
    "test:e2e:web": "playwright test --config=playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "verify:definition": "node scripts/verify-frontend-definition.mjs",
    "validate": "npm run typecheck && npm run lint && npm test -- --coverage && npm run format:check && npm run verify:definition",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@react-navigation/native": "^7.1.26",
    "@react-navigation/native-stack": "^7.3.25",
    "@react-navigation/stack": "^7.10.20",
    "@tanstack/react-query": "^5.90.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-config": "^1.6.0",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-keychain": "^10.0.0",
    "react-native-safe-area-context": "^5.6.0",
    "react-native-screens": "^4.26.2",
    "react-native-web": "^0.20.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@react-native-community/cli": "^20.0.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/jest-preset": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@testing-library/react-native": "^13.3.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^8.19.0",
    "husky": "^9.1.7",
    "jest": "^29.6.3",
    "lint-staged": "^16.2.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "~5.9.0",
    "vite": "^6.3.5"
  },
  "lint-staged": {
    "*.{js,ts,tsx,json,yml,yaml}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
